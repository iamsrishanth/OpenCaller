# Copying this file manually is not enough to start the lab. Generate fresh
# local values with scripts/new-local-env.ps1; that script writes ignored .env.
# Do not put real credentials in this example file.
OPENCALLER_BIND_ADDRESS=127.0.0.1
OPENCALLER_ADVERTISED_ADDRESS=127.0.0.1
OPENCALLER_SIP_PASSWORD_1001=generate-with-new-local-env.ps1
OPENCALLER_SIP_PASSWORD_1002=generate-with-new-local-env.ps1
OPENCALLER_VOICEMAIL_PIN_1001=generate-with-new-local-env.ps1
OPENCALLER_VOICEMAIL_PIN_1002=generate-with-new-local-env.ps1
OPENCALLER_VOICEMAIL_SYNC_TOKEN_1001=generate-with-new-local-env.ps1
